# Server
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173

# Optional: enables real AI-generated concepts via Groq's free API (https://console.groq.com)
# Leave empty to use the built-in template-based concept generator instead.
GROQ_API_KEY=

# Optional: enables emailing contact form submissions via SMTP (e.g. Gmail app password, Resend, Mailgun SMTP)
# Leave empty to only store submissions to backend/data/submissions.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
